# Variables de entorno del frontend

# URL base para la API en la web.
# Usa "/" cuando el frontend corre detras de Vite o Nginx con proxy a /api.
# Usa una URL absoluta si necesitas conectarte a una API remota.
VITE_API_BASE_URL=/

# URL base para la API en Android / Capacitor.
# Si no se define, la app usa VITE_API_BASE_URL o su fallback interno.
# Ejemplos utiles:
#   http://10.0.2.2:8000
#   http://192.168.1.100:8000
#   https://api-catv.tresvalles.hn
VITE_API_BASE_URL_NATIVE=https://api-catv.tresvalles.hn

# Alias legado opcional. Solo se usa si VITE_API_BASE_URL_NATIVE no existe.
# VITE_API_BASE_URL_ANDROID=http://10.0.2.2:8000

# Timeout de peticiones en milisegundos.
VITE_API_TIMEOUT=30000

# Logos remotos opcionales. Si se dejan vacios, la app usa los assets incluidos.
VITE_LOGO_TRESVALLES_URL=
VITE_LOGO_CHUMBAGUA_URL=
VITE_LOGO_DEFAULT_URL=
