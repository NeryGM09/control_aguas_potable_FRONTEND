# Variables de entorno para el frontend

# URL base para la API en la version web
# Ejemplos:
#   http://localhost:8000 (desarrollo local directo)
#   https://api-catv.tresvalles.hn (produccion)
VITE_API_BASE_URL=https://api-catv.tresvalles.hn

# URL base para la API en APK/plataforma nativa
# Si no se especifica, usa VITE_API_BASE_URL
# Ejemplos:
#   http://10.0.2.2:8000 (emulador Android)
#   http://192.168.1.100:8000 (dispositivo en red local)
#   https://api-catv.tresvalles.hn (produccion)
VITE_API_BASE_URL_NATIVE=https://api-catv.tresvalles.hn

# Timeout para las peticiones API (en ms, opcional)
# Ejemplos:
#   30000 (30 segundos)
#   60000 (1 minuto)
VITE_API_TIMEOUT=30000
